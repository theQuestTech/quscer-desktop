{
  "name": "quscer-desktop",
  "version": "1.0.2",
  "description": "Quscer OS desktop app",
  "main": "main.js",
  "author": "The Quest Tech",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.thequesttech.quscer",
    "productName": "Quscer OS",
    "files": [
      "main.js",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.business"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "theQuestTech",
        "repo": "quscer-desktop",
        "releaseType": "release"
      }
    ]
  }
}
